APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8010
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8010,http://localhost:8010,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175,http://127.0.0.1:5500,http://localhost:5500

# OpenRouter (required) — Llama 3.3 70B, Groq preferred
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_PROVIDER=Groq

# Optional: Google Maps Platform (Places, Geocoding, Distance Matrix)
# Leave empty to use OpenStreetMap, Nominatim, Overpass, and OSRM.
GOOGLE_MAPS_API_KEY=
